# === ファイルネーム制限 ===
# Windowsのファイル名で使えない文字 ( :*?"<>| など) を自動的に削除・置換するのじゃ
--windows-filenames

# ファイル名が長くなりすぎないよう、パスを含まないファイル名部分を250バイトに切り詰めるのじゃ
--trim-filenames 250


# === ファイル名リージョン ===
# YouTubeなどのサイトに「日本語(ja-JP)の情報を優先してほしい」と伝えるHTTPヘ_ダーを追加するのじゃ。
# これで日本語タイトルなどが取得しやすくなるぞ
--add-header Accept-Language:ja-JP

# === サムネイルダウンロード ===
# 動画のサムネイル（表紙画像）を、動画とは別の画像ファイルとして保存するのじゃ
--write-thumbnail

# (コメントアウト) もし有効にすれば、↑で保存したサムネイルを動画ファイル(mp4やmkvなど)に埋め込むのじゃ
#--embed-thumbnail


# === 字幕関連 ===
# (コメントアウト) もし有効にすれば、日本語(ja)の字幕を探してダウンロードしようとするのじゃ
#--sub-lang ja

# 利用可能な字幕（下の --sub-langs で指定した言語）があれば、それを別ファイル(.srt, .vttなど)として保存するのじゃ
--write-sub

# --write-sub と併用。利用可能な「全ての言語」の字幕をダウンロードしようとするのじゃ
#--all-subs 自動字幕の翻訳までダウンロードしようとして進行不可になる

# ↑でダウンロードした字幕ファイルを、動画ファイル自体に埋め込むのじゃ
--embed-subs

# YouTubeの自動文字起こし（AI生成の字幕）もダウンロード対象に含めるのじゃ
--write-auto-subs

# ダウンロードする字幕言語を正規表現で指定。「-orig」で終わる言語（例: en-orig, ja-orig など、元の言語のオリジナル版）を対象にするのじゃ
--sub-langs ".*-orig"


# === メタデータ ===
# 動画のタイトル、説明文、アップロード日などの情報（メタデータ）を動画ファイルに埋め込むのじゃ
--embed-metadata

# === フォーマット選択 ===
# -f は --format の略。動画・音声のフォーマットを指定するのじゃ
# ba+bv : best audio (一番良い音声) と best video (一番良い動画) を別々にダウンロードして、後で合体させる
# /b : もし↑が無理なら、best (音声・動画が一体のファイルの中で一番良いもの) を選ぶのじゃ
-f ba+bv/b

# もしVP9コーデックを優先したい場合は、このコメントアウトを外し、有効にするのじゃ
# -S は --format-sort の略。動画を選ぶ優先順位を「1.解像度(res), 2.コーデック(vp9.2), 3.品質(quality)」にする
#-S res,vcodec:vp9.2,quality

# === 実行制御 ===
# ダウンロードの進捗状況（％、速度など）をコンソールに表示するのじゃ
--progress

# (実行完了後コマンド実行)
# 動画1本の処理が完了するたびに、指定したシェルスクリプトを実行するのじゃ
# "..." の部分 (%(id)s, %(title)s など) は、ダウンロードした動画の情報に置き換えられ、スクリプトの引数として渡される (Discord通知用じゃな)
--exec 'Koa_Discord_Message.sh "yt-dlp実行完了-[%(id)s]" "チャンネル名→%(channel)s" "プレイリスト名→%(playlist)s" "プレイリストNo.%(playlist_index)s/%(n_entries)s %(autonumber)s" "タイトル→%(title)s" "ファイル情報→（長さ%(duration_string)s）,（サイズ%(filesize)s or %(filesize_approx)s）,（解像度%(resolution)s）,（%(fps)sFPS）,（ビットレート%(tbr)sKbps）,（%(release_date)s公開）" "保存ファイル名→%(filename)s" "─────"'

# (拡張子指定) 最後にコンテナを変更します
# (コメントアウト) もし有効にすれば、動画と音声を合体(merge)させる際の出力コンテナ形式を強制的に webm にするのじゃ
#--merge-output-format webm

# === ダウンローダー ===
# (aria2で高速ダウンロードするオプション)
# (ダウンロード進捗が分からなくなります) ← --progress より aria2c 側の進捗表示が優先されるためじゃな
# ダウンロード処理を、外部の高速ダウンローダー「aria2c」に任せるのじゃ
--downloader aria2c
# ↑の aria2c に渡す引数を指定。-x8 (最大接続数8), -s8 (並列ダウンロード数8), --retry-wait=1 (リトライ待機1秒) などで高速化を図るのじゃ
--downloader-args aria2c:"-x8 -s8 --retry-wait=1"

# === ファイル名テンプレート ===
# -o は --output の略。出力するファイル名とパスの形式を指定するのじゃ
#-o "%(playlist)s/%(playlist_index)s - %(title)s [%(id)s].%(ext)s"
#-o "%(channel)s/%(title)s [%(id)s].%(ext)s"
-o "%(playlist)s/%(title)s [%(id)s].%(ext)s"
#-o "%(title)s.%(ext)s"

# (ファイル名関連でエラー吐いたとき用)
# (コメントアウト) エラー回避用の安全な設定例1: チャンネル名/ID.ext
#-o "%(channel)s/%(id)s.%(ext)s"
# (コメントアウト) エラー回避用の安全な設定例2: ID.ext
#-o "%(id)s.%(ext)s"

# === 一時ファイル ===
# (ダウンロードファイルキャッシュ場)
# (どれか使って)
# -P は --paths の略。temp: で一時ファイルの保存場所を指定するのじゃ
# これが現在有効な設定。ダウンロード中や結合中の一時ファイルを /tmp ディレクトリに置く
-P temp:/tmp
#-P temp:/mnt/Linux_Data/swap